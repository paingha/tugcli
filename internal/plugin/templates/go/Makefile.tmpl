PLUGIN  := [[.Name]]
BIN     := tug-provider-$(PLUGIN)
HOST    := $(shell go env GOOS)_$(shell go env GOARCH)
TARGETS := darwin_arm64 darwin_amd64 linux_amd64 linux_arm64 windows_amd64

.PHONY: build build-all test link conformance package clean

build: ## Build for this machine
	CGO_ENABLED=0 go build -o bin/$(HOST)/$(BIN) .

build-all: ## Build every platform in plugin.yaml
	@for t in $(TARGETS); do \
		os=$${t%_*}; arch=$${t#*_}; ext=; [ $$os = windows ] && ext=.exe; \
		echo "building $$t"; \
		CGO_ENABLED=0 GOOS=$$os GOARCH=$$arch go build -trimpath -o bin/$$t/$(BIN)$$ext . || exit 1; \
	done

test: ## Unit tests
	go test ./...

link: build ## Use this directory as a development plugin
	tug plugin link .

conformance: link ## Run tug's protocol conformance suite
	TUG_SECRET_API_TOKEN=demo_test tug plugin test $(PLUGIN) --set clusters=dev=https://127.0.0.1:6443

package: build-all ## Write an installable archive to dist/
	tug plugin package . -o dist

clean:
	rm -rf bin dist
