name: Release

on:
  push:
    tags: ["v*"]

permissions:
  contents: write

env:
  # While github.com/paingha/tugcli is private, add a repository secret
  # TUGCLI_TOKEN with read access to it; the module is then fetched with git.
  GOPRIVATE: github.com/paingha/tugcli
  TUGCLI_TOKEN: ${{ secrets.TUGCLI_TOKEN }}

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - name: Check the tag matches plugin.yaml
        run: |
          want="v$(sed -n 's/^  version: *//p' plugin.yaml | head -n 1)"
          if [ "$want" != "$GITHUB_REF_NAME" ]; then
            echo "tag $GITHUB_REF_NAME does not match plugin.yaml's version ($want)" >&2
            exit 1
          fi
      - name: Allow access to the tug SDK
        if: env.TUGCLI_TOKEN != ''
        run: git config --global url."https://x-access-token:${TUGCLI_TOKEN}@github.com/paingha/tugcli".insteadOf "https://github.com/paingha/tugcli"
      - uses: actions/setup-go@v6
        with:
          go-version-file: go.mod
      - run: go test ./...
      - run: go install github.com/paingha/tugcli/cmd/tug@latest
      - run: make package
      - name: Publish the archive
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release create "$GITHUB_REF_NAME" dist/*.tar.gz --generate-notes
          echo "Install with: tug plugin install <archive URL> --sha256 $(sha256sum dist/*.tar.gz | cut -d' ' -f1)"
