# tug shell integration for bash. Add this to the end of ~/.bashrc:
#   eval "$(tug init bash)"
# Set TUG_PROMPT_DISABLE=1 to keep your prompt unchanged and use $TUG_PROMPT yourself.
# Set TUG_PIN_DISABLE=1 to ignore .tug.yaml pin files.
_tug_bin={{.Bin}}

if [ "${TUG_SESSION_PID:-}" != "$$" ]; then
  eval "$("$_tug_bin" session new --shell bash --pid $$ --parent "${TUG_SESSION:-}")"
fi

# _tug_pin applies the .tug.yaml of a new directory, if it is allowed. bash
# has no hook for cd, so the prompt checks whether the directory changed.
_tug_pin() {
  if [ "${TUG_PIN_DISABLE:-}" != 1 ] && [ "$PWD" != "${_tug_pin_pwd:-}" ]; then
    _tug_pin_pwd=$PWD
    "$_tug_bin" session pin --dir "$PWD"
  fi
}

_tug_sync() {
  _tug_pin
  local f="${TUG_SESSION_DIR:-}/kubeconfig" style text
  if [ -n "${TUG_SESSION_DIR:-}" ] && [ -f "$f" ]; then
    export KUBECONFIG="$f"
    TUG_PROMPT=""
    if [ -r "$TUG_SESSION_DIR/prompt" ] && IFS=$'\t' read -r style text < "$TUG_SESSION_DIR/prompt"; then
      case "$style" in
        prod) TUG_PROMPT=$'\001\e[1;31m\002'"⎈ ${text} (read-only)"$'\001\e[0m\002 ' ;;
        unlocked) TUG_PROMPT=$'\001\e[1;33m\002'"⎈ ${text} (unlocked)"$'\001\e[0m\002 ' ;;
        *) TUG_PROMPT=$'\001\e[36m\002'"⎈ ${text}"$'\001\e[0m\002 ' ;;
      esac
    fi
  else
    if [ "${KUBECONFIG:-}" = "$f" ]; then
      if [ -n "${TUG_ORIG_KUBECONFIG:-}" ]; then export KUBECONFIG="$TUG_ORIG_KUBECONFIG"; else unset KUBECONFIG; fi
    fi
    TUG_PROMPT=""
  fi
}

_tug_exit() {
  if [ "${TUG_SESSION_PID:-}" = "$$" ]; then
    "$_tug_bin" session end --id "$TUG_SESSION" >/dev/null 2>&1
  fi
}

tug() {
  "$_tug_bin" "$@"
  local rc=$?
  _tug_sync
  return $rc
}

case ";${PROMPT_COMMAND:-};" in
  *";_tug_sync;"*) ;;
  *) PROMPT_COMMAND="_tug_sync${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
esac

if [ -z "$(trap -p EXIT)" ]; then
  trap _tug_exit EXIT
fi

if [ "${TUG_PROMPT_DISABLE:-}" != 1 ] && [ -n "${PS1:-}" ]; then
  case "$PS1" in
    *'${TUG_PROMPT}'*) ;;
    *) PS1='${TUG_PROMPT}'"$PS1" ;;
  esac
fi

_tug_sync
