# tug shell integration for PowerShell. Add this to your $PROFILE:
#   Invoke-Expression (& tug init powershell | Out-String)
# Set $env:TUG_PROMPT_DISABLE = '1' to keep your prompt unchanged and use $global:TugPrompt yourself.
# Set $env:TUG_PIN_DISABLE = '1' to ignore .tug.yaml pin files.
$global:_TugBin = {{.Bin}}

if ($env:TUG_SESSION_PID -ne "$PID") {
    & $global:_TugBin session new --shell powershell --pid $PID --parent "$env:TUG_SESSION" | Out-String | Invoke-Expression
}

# _TugPin applies the .tug.yaml of a new directory, if it is allowed.
function global:_TugPin {
    if ($env:TUG_PIN_DISABLE -eq '1') { return }
    $here = (Get-Location).ProviderPath
    if ($here -ne $global:_TugPinPwd) {
        $global:_TugPinPwd = $here
        & $global:_TugBin session pin --dir $here
    }
}

function global:_TugSync {
    _TugPin
    $f = if ($env:TUG_SESSION_DIR) { Join-Path $env:TUG_SESSION_DIR 'kubeconfig' } else { $null }
    if ($f -and (Test-Path -LiteralPath $f)) {
        $env:KUBECONFIG = $f
        $global:TugPrompt = ''
        $p = Join-Path $env:TUG_SESSION_DIR 'prompt'
        if (Test-Path -LiteralPath $p) {
            $style, $text = (Get-Content -LiteralPath $p -TotalCount 1) -split "`t", 2
            $e = [char]27
            switch ($style) {
                'prod' { $global:TugPrompt = "$e[1;31m⎈ $text (read-only)$e[0m " }
                'unlocked' { $global:TugPrompt = "$e[1;33m⎈ $text (unlocked)$e[0m " }
                default { $global:TugPrompt = "$e[36m⎈ $text$e[0m " }
            }
        }
    } else {
        if ($f -and $env:KUBECONFIG -eq $f) {
            if ($env:TUG_ORIG_KUBECONFIG) { $env:KUBECONFIG = $env:TUG_ORIG_KUBECONFIG }
            else { Remove-Item Env:KUBECONFIG -ErrorAction SilentlyContinue }
        }
        $global:TugPrompt = ''
    }
}

function global:tug {
    & $global:_TugBin @args
    $rc = $LASTEXITCODE
    _TugSync
    $global:LASTEXITCODE = $rc
}

if ($env:TUG_PROMPT_DISABLE -ne '1' -and -not $global:_TugOrigPrompt) {
    $global:_TugOrigPrompt = $function:prompt
    function global:prompt {
        _TugSync
        "$global:TugPrompt" + (& $global:_TugOrigPrompt)
    }
}

$null = Register-EngineEvent -SourceIdentifier PowerShell.Exiting -Action {
    if ($env:TUG_SESSION_PID -eq "$PID") { & $global:_TugBin session end --id $env:TUG_SESSION *> $null }
}

_TugSync
